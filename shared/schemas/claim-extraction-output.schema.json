{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chronos-vox.local/schemas/claim-extraction-output.schema.json",
  "title": "ClaimExtractionOutput",
  "type": "object",
  "additionalProperties": false,
  "required": ["claims"],
  "properties": {
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "text",
          "evidence_start",
          "evidence_end",
          "stance",
          "topic_tags",
          "extractor_confidence"
        ],
        "properties": {
          "text": { "type": "string", "minLength": 1 },
          "evidence_start": { "type": "integer", "minimum": 0 },
          "evidence_end": { "type": "integer", "minimum": 0 },
          "stance": {
            "type": "string",
            "enum": ["support", "oppose", "mixed", "observe"]
          },
          "topic_tags": {
            "type": "array",
            "items": { "type": "string" }
          },
          "extractor_confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    }
  }
}
